{
  "input": {
    "focus_follows_mouse": true
  },
  "keybinds": [
    { "modifiers": ["Super"], "key": "Return", "action": "spawn", "args": ["kitty"] },
    { "modifiers": ["Super"], "key": "R", "action": "spawn", "args": ["fuzzel"] },
    { "modifiers": ["Super", "Shift"], "key": "L", "action": "spawn", "args": ["hyprlock"] },
    { "modifiers": ["Super"], "key": "X", "action": "close_window", "repeat": false },
    { "modifiers": ["Super"], "key": "Left", "action": "focus_window_left" },
    { "modifiers": ["Super"], "key": "Down", "action": "focus_window_down" },
    { "modifiers": ["Super"], "key": "Up", "action": "focus_window_up" },
    { "modifiers": ["Super"], "key": "Right", "action": "focus_window_right" },
    { "modifiers": ["Super"], "key": "H", "action": "focus_window_left" },
    { "modifiers": ["Super"], "key": "J", "action": "focus_window_down" },
    { "modifiers": ["Super"], "key": "K", "action": "focus_window_up" },
    { "modifiers": ["Super"], "key": "L", "action": "focus_window_right" },
    { "modifiers": ["Super", "Ctrl"], "key": "Left", "action": "move_window_left" },
    { "modifiers": ["Super", "Ctrl"], "key": "Down", "action": "move_window_down" },
    { "modifiers": ["Super", "Ctrl"], "key": "Up", "action": "move_window_up" },
    { "modifiers": ["Super", "Ctrl"], "key": "Right", "action": "move_window_right" },
    { "modifiers": ["Super", "Ctrl"], "key": "H", "action": "move_window_left" },
    { "modifiers": ["Super", "Ctrl"], "key": "J", "action": "move_window_down" },
    { "modifiers": ["Super", "Ctrl"], "key": "K", "action": "move_window_up" },
    { "modifiers": ["Super", "Ctrl"], "key": "L", "action": "move_window_right" },
    { "modifiers": ["Super", "Shift"], "key": "Left", "action": "move_pointer_left" },
    { "modifiers": ["Super", "Shift"], "key": "Down", "action": "move_pointer_down" },
    { "modifiers": ["Super", "Shift"], "key": "Up", "action": "move_pointer_up" },
    { "modifiers": ["Super", "Shift"], "key": "Right", "action": "move_pointer_right" },
    { "modifiers": ["Super"], "key": "Page_Down", "action": "focus_desktop_next" },
    { "modifiers": ["Super"], "key": "Page_Up", "action": "focus_desktop_previous" },
    { "modifiers": ["Super"], "key": "U", "action": "focus_desktop_next" },
    { "modifiers": ["Super"], "key": "I", "action": "focus_desktop_previous" },
    { "modifiers": ["Super", "Ctrl"], "key": "Page_Down", "action": "move_window_to_desktop_next" },
    { "modifiers": ["Super", "Ctrl"], "key": "Page_Up", "action": "move_window_to_desktop_previous" },
    { "modifiers": ["Super", "Ctrl"], "key": "U", "action": "move_window_to_desktop_next" },
    { "modifiers": ["Super", "Ctrl"], "key": "I", "action": "move_window_to_desktop_previous" },
    { "modifiers": ["Super"], "key": "V", "action": "toggle_always_on_top" },
    { "modifiers": ["Super", "Shift"], "key": "V", "action": "focus_window_previous" },
    { "modifiers": ["Super"], "key": "F", "action": "toggle_maximize" },
    { "modifiers": ["Super", "Shift"], "key": "F", "action": "fullscreen_window" },
    { "modifiers": ["Super", "Ctrl"], "key": "F", "action": "fit_to_output" },
    { "modifiers": ["Super"], "key": "C", "action": "center_window" },
    { "modifiers": ["Super", "Ctrl"], "key": "C", "action": "center_all_windows" },
    { "modifiers": ["Super"], "key": "Minus", "action": "set_window_width", "args": ["-10%"] },
    { "modifiers": ["Super"], "key": "Equal", "action": "set_window_width", "args": ["+10%"] },
    { "modifiers": ["Super", "Shift"], "key": "Minus", "action": "set_window_height", "args": ["-10%"] },
    { "modifiers": ["Super", "Shift"], "key": "Equal", "action": "set_window_height", "args": ["+10%"] },
    { "modifiers": ["Super"], "key": "E", "action": "quit" },
    { "modifiers": ["Super", "Shift"], "key": "E", "action": "exit_session" }
  ]
}
